{
  "manifest_version": 3,
  "name": "UTM Source Remover",
  "version": "1.0",
  "description": "Automatically removes UTM parameters from URLs in the address bar",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "UTM Source Remover"
  }
} 